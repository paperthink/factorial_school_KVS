   "source": [
    "# factorial of  n\n",
    "#n x n-1 x n-2, where n-i, i+=1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "59003220",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "factorial of the number is 120\n"
     ]
    }
   ],
   "source": [
    "i = 1\n",
    "\n",
    "\n",
    "n = int(input(\"Enter a number: \"))\n",
    "p = 1\n",
    "while i <= n:\n",
    "    p*=i\n",
    "    i+=1\n",
    "\n",
    "print(f\"factorial of the number is {p}\")\n"
   ]
  }
 ],
